# deploy/.env on the staging server: copy this file, fill it in, chmod 600.
# Never commit the filled-in copy (.gitignore and .dockerignore both exclude it).
# Generate each secret on the server; review/staging.md has the commands.

STAGING_DOMAIN=academy-staging.globaltutoringlab.com
ACME_EMAIL=

# Hex only: these go inside connection URLs.  openssl rand -hex 32
POSTGRES_PASSWORD=
APP_USER_PASSWORD=
APP_CONTROL_PASSWORD=
APP_STUDIO_PASSWORD=
APP_CONSOLE_PASSWORD=

# Shared by Caddy, the front end's edge server and the API.  openssl rand -hex 32
PROXY_SECRET=
# Seals the console's TOTP secrets.  openssl rand -base64 32
CONSOLE_TOTP_KEY=

# Basic auth on the console host. The hash comes from `caddy hash-password`
# and must stay in single quotes, or compose reads its $ signs as variables.
CONSOLE_BASIC_USER=
CONSOLE_BASIC_HASH=''

# The staging OAuth client in Google Cloud (not production's).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
