{
  "name": "trader-academy-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "psql \"${OWNER_DATABASE_URL:-postgres:///academy}\" -v ON_ERROR_STOP=1 -f db/001_schema.sql -f db/002_rls.sql -f db/003_platform_rls.sql -f db/004_content_versions_rls.sql -f db/005_request_path.sql -f db/006_attempt_lessons.sql -f db/007_pathway_and_branding.sql -f db/008_studio.sql -f db/009_studio_identity.sql",
    "test:db": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/tests/rls_proof.sql",
    "test:migrate": "sh db/tests/migrate_fresh.sh",
    "test:studio": "psql \"${OWNER_DATABASE_URL:-postgres:///academy}\" -v ON_ERROR_STOP=1 -f db/tests/studio_proof.sql",
    "test:demo-seed": "npm run --silent build && sh db/tests/demo_seed.sh",
    "demo": "sh scripts/demo.sh",
    "demo:reset": "sh scripts/demo-reset.sh",
    "test": "node --test --test-concurrency=1 dist/test/*.test.js",
    "start": "node dist/src/http/main.js",
    "console:create-owner": "node dist/src/cli/createOwner.js",
    "worker": "node dist/src/outbox/worker.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3"
  }
}
